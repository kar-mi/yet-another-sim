PORT=3000
LOG_LEVEL=warn

# Prometheus metrics endpoint. Leave METRICS_TOKEN unset to disable /metrics.
METRICS_TOKEN=
METRICS_PORT=9100
METRICS_HOST=0.0.0.0

# Sentry is enabled when a DSN is set unless SENTRY_ENABLED=false.
SENTRY_ENABLED=true
SENTRY_DSN=
SENTRY_CLIENT_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_CLIENT_TRACES_SAMPLE_RATE=0
