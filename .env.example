PORT=3000
LOG_LEVEL=warn

# Prometheus metrics endpoint. Leave METRICS_TOKEN unset to disable /metrics.
METRICS_TOKEN=
METRICS_PORT=9100
METRICS_HOST=0.0.0.0

# Server-side OpenTelemetry traces. Existing Prometheus metrics remain on /metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=yet-another-sim
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=1
