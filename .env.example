PORT=3000

# Logging verbosity only: error | warn | info | debug.
LOG_LEVEL=warn

# Deployment environment: "development" enables dev-only build behavior
# (inline sourcemaps + the client __YAS_DEBUG__ HUD). Any other value is prod.
ENVIRONMENT=production

# Maximum allocated rooms per backend (lobby/running/paused/stopped until expiry).
# Must be a positive integer; invalid values fail startup.
MAX_SESSIONS=10

# Additional browser origins allowed to open WebSockets. Same-origin requests are
# always allowed. Values must be comma-separated HTTP(S) origins for dev testing.
ALLOWED_ORIGINS=

# Prometheus metrics endpoint. Leave METRICS_TOKEN unset to disable /metrics.
METRICS_TOKEN=
METRICS_PORT=9100
METRICS_HOST=0.0.0.0

# Server-side OpenTelemetry traces. Existing Prometheus metrics remain on /metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=yet-another-sim
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=1
