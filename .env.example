PORT=3000

# Logging verbosity only: error | warn | info | debug.
LOG_LEVEL=warn

# Deployment environment: "development" enables dev-only build behavior
# (inline sourcemaps + the client __YAS_DEBUG__ HUD). Any other value is prod.
ENVIRONMENT=production

# Maximum allocated rooms per backend (lobby/running/paused/stopped until expiry).
# Must be a positive integer; invalid values fail startup.
MAX_SESSIONS=10

# Maximum concurrent WebSocket connections from a single client IP. Guards the room
# pool against connection-flood exhaustion; keep high enough for NAT/shared IPs.
# Must be a positive integer; invalid values fail startup.
MAX_CONNECTIONS_PER_IP=16

# Maximum inbound WebSocket messages per second per connection. Excess messages are
# dropped (the connection stays open). Set well above normal play; only trips on floods.
# Must be a positive integer; invalid values fail startup.
MAX_WS_MSGS_PER_SEC=300

# Browser origins (comma-separated HTTP(S)) allowed to open WebSockets, in addition
# to same-origin requests. NOTE: behind a TLS-terminating proxy (Caddy) the backend
# sees the connection as http on 127.0.0.1, so the browser's https Origin never
# matches the same-origin fallback — production MUST list its public origin here
ALLOWED_ORIGINS=

# Prometheus metrics endpoint. Leave METRICS_TOKEN unset to disable /metrics.
METRICS_TOKEN=
METRICS_PORT=9100
METRICS_HOST=0.0.0.0

# Server-side OpenTelemetry traces. Existing Prometheus metrics remain on /metrics.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=yet-another-sim
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=1
